# Copy to .env next to docker-compose.yml. Compose loads it automatically,
# and .env is gitignored so it never reaches the repository.

# --- Image selection ---------------------------------------------------
# latest        = newest build of main (default)
# main          = same thing, explicitly
# multi-user    = the multi-user build, once that branch exists
# v1.2.0        = a tagged release
# sha-<40 hex>  = one exact commit, for pinning or rollback
#IMAGE_TAG=latest

# --- Host wiring -------------------------------------------------------
#HOST_PORT=3001
#CONTAINER_NAME=task-manager
# Only change this to run a SECOND instance beside the first — a different
# volume name means a separate database.
#DATA_VOLUME=task-manager-data

# --- Accounts ----------------------------------------------------------
# single (default) = no login screen, one implicit owner. This is the
#                    personal deployment and behaves as it always has.
# multi            = email + password accounts, each with entirely separate
#                    workspaces, projects, tasks, notes, settings and API key.
#AUTH_MODE=single

# AUTH_MODE=multi sends a session cookie, so it requires TLS. Put the app
# behind a reverse proxy that terminates it and set TRUST_PROXY=1 — that is
# what marks the cookie Secure. The server refuses to start in multi mode
# without it, unless you accept the risk on a trusted network:
#TRUST_PROXY=1
#ALLOW_INSECURE=1

# Whether anyone who can reach the URL may create an account. Leave false and
# the owner adds accounts; the FIRST account is always created through the
# one-time setup screen regardless.
#ALLOW_REGISTRATION=false
#SESSION_TTL_DAYS=30

# --- Dates & notifications ---------------------------------------------
# "Today" and the daily digest time follow the server clock, which in a
# container is UTC unless set here.
#TZ=Europe/London
# Contact the browsers' push services can reach you on (mailto: or https:).
# VAPID keys themselves are generated on first use and kept in the database.
#VAPID_SUBJECT=mailto:you@example.com

# --- AI (optional) -----------------------------------------------------
# A key entered in the app's Settings page takes precedence over this one.
# In multi mode each account holds its own key, and this one is an
# instance-wide fallback that every account would spend. Set
# AI_ENV_KEY_SHARED=0 to restrict AI to accounts that supply their own.
#ANTHROPIC_API_KEY=sk-ant-your-key-here
#AI_ENV_KEY_SHARED=0
#CLAUDE_MODEL=claude-opus-4-8
